#!/bin/sh
# alternix-exe — run a Windows program with the runner chosen in
# Settings > Emulation (Emulation/Runner = wine | proton | raven).
#
#   alternix-exe                    open Wine's file manager (browse C:)
#   alternix-exe /path/to/app.exe   run that program
#
# Reads ~/.config/Alternix/osm-settings.conf, the same QSettings INI that
# emulation.cpp writes.

set -u

CONF="$HOME/.config/Alternix/osm-settings.conf"
LOG="$HOME/.cache/Alternix/alternix-exe.log"
mkdir -p "$(dirname "$LOG")" 2>/dev/null || true

PROTON_ROOT="$HOME/.local/share/Alternix/proton"
PROTON_PREFIX="$HOME/.local/share/Alternix/proton-prefix"
RAVEN_BIN="$HOME/.local/share/Alternix/raven/source/build/native/raven"
RAVEN_DEFAULT_PREFIX="$HOME/.local/share/Alternix/raven/prefixes/default"

_err() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "Windows apps" "$1" 2>/dev/null || true
    fi
    echo "$1" >>"$LOG"
    exit 1
}

# Read a key from the [Emulation] section of the INI.
_cfg() {
    [ -f "$CONF" ] || return 0
    sed -n '/^\[Emulation\]/,/^\[/p' "$CONF" 2>/dev/null \
        | sed -n "s/^$1[[:space:]]*=[[:space:]]*//p" \
        | head -n1 \
        | tr -d '\r'
}

# Mirror findProtonBuilds()/selectedProtonDir(): a build is any directory
# containing a `proton` script, preferring the one named in the config.
_proton_dir() {
    want=$(_cfg ProtonBuild)
    first=""
    for root in "$PROTON_ROOT" \
                "$HOME/.steam/root/compatibilitytools.d" \
                "$HOME/.steam/steam/compatibilitytools.d" \
                "$HOME/.local/share/Steam/compatibilitytools.d"; do
        [ -d "$root" ] || continue
        for d in "$root"/*; do
            [ -f "$d/proton" ] || continue
            [ -n "$first" ] || first="$d"
            if [ -n "$want" ] && [ "$(basename "$d")" = "$want" ]; then
                printf '%s' "$d"
                return 0
            fi
        done
    done
    printf '%s' "$first"
}

RUNNER=$(_cfg Runner)
[ -n "$RUNNER" ] || RUNNER="wine"

TARGET="${1:-}"
if [ -n "$TARGET" ] && [ ! -f "$TARGET" ]; then
    _err "Not found: $TARGET"
fi

if [ "$RUNNER" = "raven" ]; then
    [ "$(uname -m)" = "x86_64" ] || _err "Raven currently supports x86-64 Linux only."
    [ -x "$RAVEN_BIN" ] || _err "Raven has not been built. Open Settings > Emulation > Build Raven."

    # Raven does not provide Wine's Explorer interface. Open its own control
    # panel when invoked without an EXE path, or let the user choose a file.
    if [ -z "$TARGET" ]; then
        if [ -f "$HOME/.local/share/Alternix/raven/source/build/native/control.exe" ]; then
            TARGET="$HOME/.local/share/Alternix/raven/source/build/native/control.exe"
        elif command -v zenity >/dev/null 2>&1; then
            TARGET=$(zenity --file-selection --title="Select a Windows program for Raven" --file-filter='Windows programs | *.exe' 2>/dev/null) || exit 0
        else
            _err "Choose a Windows .exe in your file manager. Raven does not have Wine Explorer."
        fi
    fi
    [ -f "$TARGET" ] || _err "Windows executable not found: $TARGET"

    # Same prefix must be used for BOTH the installer and the installed app.
    # Users can select an application-specific prefix in Settings > Emulation.
    RPREFIX=$(_cfg RavenPrefix)
    [ -n "$RPREFIX" ] || RPREFIX="$RAVEN_DEFAULT_PREFIX"
    case "$RPREFIX" in
        /*) ;;
        *) _err "Raven prefix must be an absolute path: $RPREFIX" ;;
    esac
    export RAVEN_PREFIX="$RPREFIX"
    mkdir -p "$RAVEN_PREFIX" || _err "Cannot create Raven prefix: $RAVEN_PREFIX"

    if [ -n "${WAYLAND_DISPLAY:-}" ]; then
        DESKTOP=wayland
    elif [ -n "${DISPLAY:-}" ]; then
        DESKTOP=x11
    else
        _err "Raven needs a Wayland or X11 display session."
    fi
    cd "$(dirname "$TARGET")" || exit 1
    # Avoid the upstream five-second default timeout for GUI programs.
    exec "$RAVEN_BIN" --run-process --execution=native --timeout-ms=86400000 \
        "--desktop=$DESKTOP" "$TARGET" >>"$LOG" 2>&1
fi

if [ "$RUNNER" = "proton" ]; then
    PDIR=$(_proton_dir)
    if [ -z "$PDIR" ]; then
        _err "No Proton build is installed. Falling back requires Wine — set the runner to Wine in Settings > Emulation."
    fi
    command -v python3 >/dev/null 2>&1 || _err "Proton needs python3, which is not installed."

    export STEAM_COMPAT_DATA_PATH="$PROTON_PREFIX"
    export STEAM_COMPAT_CLIENT_INSTALL_PATH="$HOME/.steam/steam"
    mkdir -p "$STEAM_COMPAT_DATA_PATH" "$STEAM_COMPAT_CLIENT_INSTALL_PATH" 2>/dev/null || true

    if [ -n "$TARGET" ]; then
        exec "$PDIR/proton" run "$TARGET" >>"$LOG" 2>&1
    fi
    exec "$PDIR/proton" run explorer.exe >>"$LOG" 2>&1
fi

command -v wine >/dev/null 2>&1 || \
    _err "Wine is not installed. Use Settings > Emulation > Install / setup."

if [ -n "$TARGET" ]; then
    cd "$(dirname "$TARGET")" 2>/dev/null || true
    exec wine "$(basename "$TARGET")" >>"$LOG" 2>&1
fi

# No argument: Wine's own file manager, so there is something to click.
exec wine explorer >>"$LOG" 2>&1

#!/bin/sh
# alternix-exe — run a Windows program with the runner chosen in
# Settings > Emulation (Emulation/Runner = wine | proton).
#
#   alternix-exe / --desktop         open the dedicated Windows desktop (group 3)
#   alternix-exe /path/to/app.exe    run that program inside the Windows desktop
#   alternix-exe /path/app.exe args  pass arguments to that program
#
# Reads ~/.config/Alternix/osm-settings.conf, the same QSettings INI that
# emulation.cpp writes.

set -u

CONF="$HOME/.config/Alternix/osm-settings.conf"
LOG="$HOME/.cache/Alternix/alternix-exe.log"
mkdir -p "$(dirname "$LOG")" 2>/dev/null || true

PROTON_ROOT="$HOME/.local/share/Alternix/proton"
PROTON_PREFIX="$HOME/.local/share/Alternix/proton-prefix"

_err() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "Windows apps" "$1" 2>/dev/null || true
    fi
    echo "$1" >>"$LOG"
    exit 1
}

# Read a key from the [Emulation] section of the INI.
_cfg() {
    [ -f "$CONF" ] || return 0
    sed -n '/^\[Emulation\]/,/^\[/p' "$CONF" 2>/dev/null \
        | sed -n "s/^$1[[:space:]]*=[[:space:]]*//p" \
        | head -n1 \
        | tr -d '\r'
}

# Mirror findProtonBuilds()/selectedProtonDir(): a build is any directory
# containing a `proton` script, preferring the one named in the config.
_proton_dir() {
    want=$(_cfg ProtonBuild)
    first=""
    for root in "$PROTON_ROOT" \
                "$HOME/.steam/root/compatibilitytools.d" \
                "$HOME/.steam/steam/compatibilitytools.d" \
                "$HOME/.local/share/Steam/compatibilitytools.d"; do
        [ -d "$root" ] || continue
        for d in "$root"/*; do
            [ -f "$d/proton" ] || continue
            [ -n "$first" ] || first="$d"
            if [ -n "$want" ] && [ "$(basename "$d")" = "$want" ]; then
                printf '%s' "$d"
                return 0
            fi
        done
    done
    printf '%s' "$first"
}

RUNNER=$(_cfg Runner)
# Unsupported settings saved by older versions automatically fall back to Wine.
[ "$RUNNER" = "proton" ] || RUNNER="wine"

# Qtile passes the usable group-3 dimensions; standalone invocations can use
# ALTERNIX_DESKTOP_SIZE=WIDTHxHEIGHT. Keep both Wine and Proton on the SAME
# named Wine virtual desktop rather than scattering windows across Linux.
SIZE="${ALTERNIX_DESKTOP_SIZE:-1280x720}"
case "$SIZE" in
    *x*) WIDTH=${SIZE%x*}; HEIGHT=${SIZE#*x} ;;
    *) WIDTH=1280; HEIGHT=720 ;;
esac
case "$WIDTH:$HEIGHT" in
    *[!0-9:]*|:*|*:) WIDTH=1280; HEIGHT=720 ;;
esac
[ "$WIDTH" -ge 640 ] 2>/dev/null || WIDTH=1280
[ "$HEIGHT" -ge 480 ] 2>/dev/null || HEIGHT=720
VDESKTOP="/desktop=Alternix-Windows,${WIDTH}x${HEIGHT}"

# --desktop can be used by Qtile for its automatic group-3 startup. A plain
# invocation does exactly the same thing for compatibility with old shortcuts.
if [ "${1:-}" = '--desktop' ]; then
    shift
fi
TARGET="${1:-}"
if [ -n "$TARGET" ]; then
    [ -f "$TARGET" ] || _err "Not found: $TARGET"
    shift
    TARGET_DIR=$(dirname "$TARGET")
    TARGET_NAME=$(basename "$TARGET")
    cd "$TARGET_DIR" 2>/dev/null || _err "Cannot access: $TARGET_DIR"
fi

if [ "$RUNNER" = "proton" ]; then
    PDIR=$(_proton_dir)
    if [ -z "$PDIR" ]; then
        _err "No Proton build is installed. Falling back requires Wine — set the runner to Wine in Settings > Emulation."
    fi
    command -v python3 >/dev/null 2>&1 || _err "Proton needs python3, which is not installed."

    export STEAM_COMPAT_DATA_PATH="$PROTON_PREFIX"
    export STEAM_COMPAT_CLIENT_INSTALL_PATH="$HOME/.steam/steam"
    mkdir -p "$STEAM_COMPAT_DATA_PATH" "$STEAM_COMPAT_CLIENT_INSTALL_PATH" 2>/dev/null || true

    if [ -n "$TARGET" ]; then
        exec "$PDIR/proton" run explorer.exe "$VDESKTOP" "$TARGET_NAME" "$@" >>"$LOG" 2>&1
    fi
    exec "$PDIR/proton" run explorer.exe "$VDESKTOP" >>"$LOG" 2>&1
fi

command -v wine >/dev/null 2>&1 || \
    _err "Wine is not installed. Use Settings > Emulation > Install / setup."

if [ -n "$TARGET" ]; then
    exec wine explorer "$VDESKTOP" "$TARGET_NAME" "$@" >>"$LOG" 2>&1
fi

# No argument: a persistent Windows-style desktop, not a native Windows OS.
exec wine explorer "$VDESKTOP" >>"$LOG" 2>&1

#!/bin/sh
# alternix-waydroid-session — SysVinit-compatible Waydroid lifecycle.
# Shared by Qtile and Settings > Emulation. No systemctl/systemd dependency.
#   (no arguments) / --start  start or thaw the container and show Android
#   --freeze                 freeze container when possible (no login prompt)
#   --stop                   stop BOTH the session and the container
# All failures are logged and returned with nonzero exit status.

set -u

LOG="$HOME/.cache/Alternix/waydroid-session.log"
WLOG="$HOME/.cache/Alternix/weston.log"
mkdir -p "$(dirname "$LOG")" || exit 1

_log() {
    printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOG"
}
_fail() {
    _log "ERROR: $*"
    printf '%s\n' "Waydroid: $*" >&2
    return 1
}

# Waydroid's CLI status reflects the actual container/session, unlike pgrep,
# which reports a startup process as successful before Android is running.
_status() { waydroid status 2>/dev/null || true; }
_container_running() { _status | grep -Eiq '^[[:space:]]*Container:[[:space:]]*RUNNING'; }
_session_running()   { _status | grep -Eiq '^[[:space:]]*Session:[[:space:]]*RUNNING'; }

# Never use the pattern as though it were a Unix password. sudo -A requires
# a real SUDO_ASKPASS implementation, which must be configured by Alternix.
# If this fails, propagate the error instead of pretending it started.
_root() {
    if [ "$(id -u)" -eq 0 ]; then
        "$@"
    elif sudo -n true 2>/dev/null; then
        sudo -n "$@"
    elif [ "${NO_AUTH_PROMPT:-0}" = 1 ]; then
        return 1
    elif command -v osm-sudo >/dev/null 2>&1; then
        SUDO_ASKPASS=$(command -v osm-sudo) sudo -A "$@"
    else
        _log "No configured graphical sudo askpass; osm-sudo missing"
        return 1
    fi
}

# Use the real elogind runtime directory when valid; fallback is private.
_rt_setup() {
    RT="${XDG_RUNTIME_DIR:-}"
    if [ -z "$RT" ] || [ ! -d "$RT" ] || [ "$(stat -c %u "$RT" 2>/dev/null || echo unknown)" != "$(id -u)" ]; then
        RT="/tmp/alternix-runtime-$(id -u)"
        if [ -e "$RT" ] && [ "$(stat -c %u "$RT" 2>/dev/null || echo unknown)" != "$(id -u)" ]; then
            _fail "Runtime path is owned by another account: $RT" || return 1
        fi
        (umask 077; mkdir -p "$RT") || return 1
    fi
    chmod 700 "$RT" || return 1
    export XDG_RUNTIME_DIR="$RT"
}

# Make sure the session bus is inherited. On an X11 session started without
# dbus-launch, establish a bus for this launcher instead of failing silently.
_dbus_setup() {
    if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -S "$RT/bus" ]; then
        DBUS_SESSION_BUS_ADDRESS="unix:path=$RT/bus"
        export DBUS_SESSION_BUS_ADDRESS
    fi
    if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
        if ! command -v dbus-launch >/dev/null 2>&1; then
            _fail "No user D-Bus session. Install dbus-x11 / launch Qtile with dbus-run-session." || return 1
        fi
        # dbus-launch output contains only the standard address / PID exports.
        eval "$(dbus-launch --sh-syntax)" || return 1
        _log "Started private D-Bus session for Waydroid launcher"
    fi
    if command -v dbus-send >/dev/null 2>&1; then
        if ! dbus-send --system --print-reply --dest=org.freedesktop.DBus \
            / org.freedesktop.DBus.ListNames >/dev/null 2>&1; then
            _fail "System D-Bus is unavailable. Enable the dbus service under SysVinit." || return 1
        fi
    fi
}

# Weston should create a private Wayland socket inside X11/Qtile. In a native
# Wayland session it is not needed.
_wayland_setup() {
    WL="${WAYLAND_DISPLAY:-}"
    if [ -n "$WL" ]; then
        case "$WL" in
            /*) [ -S "$WL" ] || { _fail "Wayland socket is missing: $WL"; return 1; } ;;
            *)  [ -S "$RT/$WL" ] || { _fail "Wayland socket is missing: $RT/$WL"; return 1; } ;;
        esac
        return 0
    fi

    [ -n "${DISPLAY:-}" ] || { _fail "No X11 or Wayland display available"; return 1; }
    command -v weston >/dev/null 2>&1 || { _fail "Weston is missing. Install Weston in Settings > Emulation"; return 1; }

    WL="waydroid-0"
    if [ ! -S "$RT/$WL" ] || ! pgrep -f '[w]eston.*--socket=waydroid-0' >/dev/null 2>&1; then
        # Clean only the private socket that this helper manages.
        rm -f "$RT/$WL" "$RT/$WL.lock"
        _log "Starting nested Weston on X11 display ${DISPLAY:-}"
        (
            weston --socket=waydroid-0 --backend=x11 >"$WLOG" 2>&1 ||
            weston --socket=waydroid-0 --backend=x11-backend.so >>"$WLOG" 2>&1
        ) &
        i=0
        while [ "$i" -lt 40 ]; do
            [ -S "$RT/$WL" ] && break
            sleep 0.5
            i=$((i + 1))
        done
        if [ ! -S "$RT/$WL" ]; then
            _fail "Weston failed: see $WLOG" || return 1
        fi
    fi
    export WAYLAND_DISPLAY="$WL"
}

_start_container() {
    _container_running && return 0
    _log "Starting Waydroid root container"
    # Long-lived root process; do not wait for it to exit. Capture errors.
    (_root waydroid container start >>"$LOG" 2>&1 ||
        _log "ERROR: Waydroid container command exited. Check sudo/Waydroid logs.") &
    i=0
    while [ "$i" -lt 90 ]; do
        _container_running && return 0
        sleep 1
        i=$((i + 1))
    done
    _fail "Container did not reach RUNNING. Check $LOG and /var/lib/waydroid/waydroid.log"
}

_start_session() {
    _session_running && return 0
    _log "Starting Android user session (WAYLAND_DISPLAY=$WAYLAND_DISPLAY)"
    (waydroid session start >>"$LOG" 2>&1 ||
        _log "ERROR: Waydroid session start exited unsuccessfully") &
    i=0
    while [ "$i" -lt 90 ]; do
        _session_running && return 0
        sleep 1
        i=$((i + 1))
    done
    _fail "Android session did not reach RUNNING. Check $LOG and Waydroid status"
}

case "${1:---start}" in
    --stop)
        if ! command -v waydroid >/dev/null 2>&1; then exit 0; fi
        _rt_setup || exit 1
        _dbus_setup || exit 1
        _log "Stopping Waydroid session and container"
        waydroid session stop >>"$LOG" 2>&1 || true
        if ! _root waydroid container stop >>"$LOG" 2>&1; then
            _fail "Could not stop root container (check graphical sudo authorization)" || exit 1
        fi
        # Only the Weston instance belonging to this user/socket.
        pkill -f '[w]eston.*--socket=waydroid-0' >/dev/null 2>&1 || true
        exit 0
        ;;
    --freeze)
        command -v waydroid >/dev/null 2>&1 || exit 0
        _container_running || exit 0
        NO_AUTH_PROMPT=1
        export NO_AUTH_PROMPT
        # A background workspace switch must never trigger a password prompt.
        if ! _root waydroid container freeze >>"$LOG" 2>&1; then
            _log "Freeze skipped (no existing root authorization or container not ready)"
        fi
        exit 0
        ;;
    --start|'') ;;
    *) _fail "Unknown action: $1"; exit 2 ;;
esac

command -v waydroid >/dev/null 2>&1 || { _fail "Waydroid is not installed"; exit 1; }
[ -f /var/lib/waydroid/waydroid.cfg ] || { _fail "Android system is not initialised"; exit 1; }

# Do NOT reject startup merely because binder nodes do not exist yet.
# Waydroid's own privileged container manager probes binder_linux, mounts
# binderfs and allocates anbox binder nodes as it starts. A preflight check
# here would incorrectly prevent exactly that setup.
if [ ! -e /dev/binderfs/binder-control ] && \
   ! { [ -e /dev/binder ] && [ -e /dev/hwbinder ] && [ -e /dev/vndbinder ]; } && \
   ! { [ -e /dev/anbox-binder ] && [ -e /dev/anbox-hwbinder ] && [ -e /dev/anbox-vndbinder ]; }; then
    _log "Binder nodes absent before launch; letting Waydroid probe/create them"
fi

_rt_setup || exit 1
_dbus_setup || exit 1
_wayland_setup || exit 1

# When Qtile auto-freezes Android, unfreeze without mistakenly treating a
# frozen container as a stopped one.
if _status | grep -Eiq '^[[:space:]]*Container:[[:space:]]*FROZEN'; then
    _log "Resuming frozen Waydroid container"
    if ! _root waydroid container unfreeze >>"$LOG" 2>&1; then
        _fail "Could not unfreeze container (root authorization required)" || exit 1
    fi
fi
_start_container || exit 1
_start_session || exit 1

_log "Android session ready, opening Android UI"
waydroid show-full-ui >>"$LOG" 2>&1 &
exit 0

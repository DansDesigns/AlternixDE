[%General]
author=AlternixOS
comment=Alternix VLC native Qt theme, charcoal and green, retaining native window handling.
respect_DE=false
x11drag=false
composite=false
menu_shadow_depth=4
tooltip_shadow_depth=2
layout_spacing=5
layout_margin=6
scroll_width=10
scroll_min_extent=28
slider_width=7
slider_handle_width=16
slider_handle_length=16
scroll_arrows=false
check_size=16
small_icon_size=16
button_icon_size=20
toolbar_icon_size=22
slim_toolbars=false
center_toolbar_handle=true
group_toolbar_buttons=false
toolbar_item_spacing=4
toolbar_interior_spacing=4
no_active_tab_separator=true
progressbar_thickness=9
frame.expansion=0

[GeneralColors]
window.color=#292B2D
base.color=#202225
alt.base.color=#2F3235
button.color=#54575B
light.color=#777B7C
mid.light.color=#626568
dark.color=#17191B
mid.color=#383B3E
highlight.color=#28DA58
inactive.highlight.color=#356D46
text.color=#E9EEEA
window.text.color=#E9EEEA
button.text.color=#F2F6F3
disabled.text.color=#8C9691
tooltip.base.color=#25272A
tooltip.text.color=#E9EEEA
highlight.text.color=#101B12
link.color=#43E478
link.visited.color=#8DD9A1
progress.indicator.text.color=#F2F6F3

[Hacks]
respect_darkness=true
transparent_pcmanfm_view=false
no_selection_tint=true
normal_default_pushbutton=false
iconless_pushbutton=false
iconless_menu=false

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=8
frame.bottom=8
frame.left=8
frame.right=8
interior=true
interior.element=button
text.normal.color=#F1F5F2
text.focus.color=#FFFFFF
text.press.color=#FFFFFF
text.toggle.color=#FFFFFF
text.shadow=false
text.margin.top=4
text.margin.bottom=4
text.margin.left=7
text.margin.right=7
text.iconspacing=5
indicator.element=arrow
indicator.size=9
min_height=26

[PanelButtonTool]
inherits=PanelButtonCommand
interior.element=tbutton
frame.element=tbutton
text.margin.top=3
text.margin.bottom=3
text.margin.left=6
text.margin.right=6
min_height=27

[ToolbarButton]
interior.element=tbutton
frame.element=tbutton
text.normal.color=#F1F5F2
text.focus.color=#FFFFFF
text.press.color=#FFFFFF
text.toggle.color=#FFFFFF

[Toolbar]
frame=false
interior=true
interior.element=toolbar

[Dock]
frame=false
interior=true
interior.element=dock

[DockTitle]
interior=true
interior.element=dock
frame=false
text.normal.color=#F1F5F2
text.bold=true

[LineEdit]
inherits=PanelButtonCommand
interior.element=lineedit
frame.element=lineedit
text.margin.left=7
text.margin.right=7

[ComboBox]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
indicator.element=arrow-down
indicator.size=10

[GenericFrame]
inherits=PanelButtonCommand
frame=true
frame.element=common
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
interior=true
interior.element=common

[Tab]
inherits=PanelButtonCommand
frame.element=tab
interior.element=tab
text.margin.left=10
text.margin.right=10
text.margin.top=4
text.margin.bottom=4

[TabFrame]
inherits=GenericFrame

[HeaderSection]
inherits=PanelButtonCommand
frame.element=header
interior.element=header

[Slider]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=slider

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=slidercursor

[Progressbar]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=slider

[ProgressbarContents]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=progress-pattern

[ScrollbarSlider]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=scrollbarslider

[ScrollbarGroove]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=slider

[Scrollbar]
inherits=PanelButtonCommand
indicator.size=9

[ItemView]
inherits=GenericFrame
frame=false
interior=false
text.normal.color=#E9EEEA
text.focus.color=#FFFFFF
text.margin=0

[Menu]
inherits=PanelButtonCommand
frame=true
frame.element=menu
interior=true
interior.element=menu

[MenuItem]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=menuitem
text.margin.left=8
text.margin.right=8
text.margin.top=4
text.margin.bottom=4
min_height=22

[MenuBar]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=toolbar

[MenuBarItem]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=menubaritem

[GroupBox]
inherits=GenericFrame
frame.element=common
interior.element=common
text.margin.top=4

[ToolTip]
inherits=GenericFrame
frame.element=tooltip
interior.element=tooltip

[Window]
interior=true
interior.element=window
frame=false

[Dialog]
inherits=Window

[Splitter]
frame=false
interior=true
interior.element=splitter

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=checkbox

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=radio

[IndicatorArrow]
indicator.element=arrow
indicator.size=9

[DropDownButton]
indicator.element=arrow-down
indicator.size=9

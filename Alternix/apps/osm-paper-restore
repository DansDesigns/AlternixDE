#!/usr/bin/env python3
import os
import configparser
import subprocess

# The same configuration file used by osm-paper and osm-lockscreen.
config_path = os.path.expanduser("~/.config/Alternix/osm-paper.conf")
if not os.path.isfile(config_path):
    raise SystemExit(0)

cfg = configparser.ConfigParser(interpolation=None)
try:
    cfg.read(config_path)
    if not cfg.has_section("last"):
        raise SystemExit(0)
    wall = os.path.expanduser(cfg.get("last", "wallpaper", fallback="").strip())
    mode = cfg.get("last", "mode", fallback="zoom").strip()
except (OSError, configparser.Error):
    raise SystemExit(0)

if not wall or not os.path.isfile(wall):
    raise SystemExit(0)

mode_map = {
    "zoom":   "--zoom",
    "fit":    "--stretch",
    "tile":   "--tile",
    "center": "--center",
}

subprocess.Popen(["xwallpaper", mode_map.get(mode, "--zoom"), wall])

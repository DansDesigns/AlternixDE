#!/bin/bash

REPO_URL="https://github.com/DansDesigns/Alternix.git"
VERSION_URL="https://raw.githubusercontent.com/DansDesigns/Alternix/update/version.txt"

LOCAL_VERSION=$(cat /usr/share/alternix/version.txt 2>/dev/null)
REMOTE_VERSION=$(curl -fs $VERSION_URL)

if [ -z "$REMOTE_VERSION" ]; then
    echo "Unable to check for updates."
    exit 1
fi

if dpkg --compare-versions "$REMOTE_VERSION" gt "$LOCAL_VERSION"; then
    echo "New version available: $REMOTE_VERSION"
    echo " "
    echo "Updating Alternix..."


    git clone "$REPO_URL" || exit 1
    cd Alternix

    chmod +x install-update.sh
    sudo ./install-update.sh

    echo "$REMOTE_VERSION" | sudo tee /usr/share/alternix/version.txt

    cd /
    rm -rf "$TMP_DIR"

    echo "Update complete."
else
    echo "Alternix is up to date."
fi
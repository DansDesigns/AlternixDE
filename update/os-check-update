#!/bin/bash

# Run the updater in the logged-in user's session. Ordinary sudo invokes
# Alternix PAM when installed; never hide prompts via sudo -n.
# Do not relaunch the entire script as root (which redirects user paths).
if (( EUID == 0 )); then
    echo "ERROR: System Update must be launched by the desktop user, not as root." >&2
    exit 1
fi

# The final update choices use Alacritty's SGR mouse reporting. Restore
# terminal input and disable mouse reporting before any sudo/reboot prompt,
# including when the updater is interrupted or exits unexpectedly.
ALT_MENU_FD=
ALT_MENU_STTY=
ALT_MENU_MOUSE_ACTIVE=0
alt_menu_cleanup() {
    if [[ -n "$ALT_MENU_FD" ]]; then
        if [[ "$ALT_MENU_MOUSE_ACTIVE" == 1 ]]; then
            printf '\033[?1000l\033[?1006l' >&"$ALT_MENU_FD" || true
            ALT_MENU_MOUSE_ACTIVE=0
        fi
        if [[ -n "$ALT_MENU_STTY" ]]; then
            stty "$ALT_MENU_STTY" <&"$ALT_MENU_FD" || true
            ALT_MENU_STTY=
        fi
        exec {ALT_MENU_FD}>&-
        ALT_MENU_FD=
    fi
}

# Show an error before Alacritty closes, while retaining the existing
# five-second close on a normal no-update run.
update_exit_status() {
    local result=$?
    trap - EXIT
    alt_menu_cleanup
    if (( result != 0 )); then
        echo ""
        echo "[ERROR] System Update stopped (exit status $result)."
        read -r -p "Press Enter to close this window... " _ || true
    fi
}
trap update_exit_status EXIT

if ! command -v nala >/dev/null 2>&1; then
    echo "ERROR: Nala is not installed. System Update requires the nala package." >&2
    exit 1
fi

# Fresh ISO preview builds intentionally do not enrol a shared pattern.
# An installed system must activate its own root-protected pattern first.
# Activate at the FIRST updater run, while the user still has the standard
# Unix-password sudo policy to authorise credential migration/enrolment.
# Activation is a separate root-approved operation, never a NOPASSWD bypass.
AUTH_SOURCE_DIR=/usr/share/alternix/auth
# live-boot mounts only exist in the running live-preview session, not in the
# installed system created by the installer. Never enrol credentials in the
# throwaway preview environment.
ALT_RUNNING_LIVE=0
if [ -e /run/live/medium ] || [ -d /lib/live/mount/medium ] || [ -d /run/live/overlay ]; then
    ALT_RUNNING_LIVE=1
fi
if [ "$ALT_RUNNING_LIVE" != 1 ] && ! grep -Eq '^auth[[:space:]]+requisite[[:space:]]+pam_exec\.so.*alternix-auth[[:space:]]+--pam' /etc/pam.d/sudo 2>/dev/null; then
    if [ -f "$AUTH_SOURCE_DIR/alternix-auth-setup.sh" ] &&
       [ -f "$AUTH_SOURCE_DIR/alternix-auth.c" ] &&
       [ -f "$AUTH_SOURCE_DIR/osm-lock.cpp" ]; then
        echo "[Security] This installation has not activated Alternix pattern authentication yet."
        echo "[Security] One initial Unix administrator password is required to enrol/migrate the pattern."
        if ! /usr/bin/sudo -v; then
            echo "ERROR: Initial administrator authorisation failed." >&2
            exit 1
        fi
        if ! /usr/bin/sudo /bin/bash "$AUTH_SOURCE_DIR/alternix-auth-setup.sh" \
                "$(id -un)" "$AUTH_SOURCE_DIR"; then
            echo "ERROR: Pattern/PIN setup did not complete. Its root-owned transaction restores the previous sudo configuration on failure." >&2
            echo "ERROR: System Update will not continue until authentication is working." >&2
            exit 1
        fi
        # The root-owned setup has already completed a live sudo/PAM test;
        # do not invalidate that test or forcibly trigger another challenge.
    else
        echo "WARNING: Alternix PAM sources are not installed in $AUTH_SOURCE_DIR." >&2
        echo "WARNING: Standard Unix-password sudo remains in use. Update/install the authentication sources first." >&2
    fi
fi
# Ask sudo once. When activated, sudo/PAM displays the pattern/PIN window.
echo "Authenticating with Alternix..."
if ! /usr/bin/sudo -v; then
    echo "ERROR: System authentication failed or elevation was denied." >&2
    exit 1
fi

LOCAL_VERSION=$(cat /usr/share/alternix/version.txt 2>/dev/null)

echo "=============================================="
echo "          Alternix Desktop Updater"
echo "=============================================="
echo " -------> Teaching Penguins to fly! <-------"
echo " "
echo "=============================================="
echo "       Current Version: $LOCAL_VERSION"
echo "=============================================="
echo "Checking for Linux System Updates..."
echo " "
if ! sudo nala update; then
    echo "ERROR: Nala could not refresh the system package lists." >&2
    exit 1
fi
echo " "
echo "Applying Upgrades…"
echo " "
if ! sudo nala upgrade -y; then
    echo "ERROR: Nala failed to upgrade the system packages." >&2
    exit 1
fi
echo " "
echo "Checking for Alternix Updates..."

REPO_URL="https://github.com/DansDesigns/AlternixDE.git"
VERSION_URL="https://raw.githubusercontent.com/DansDesigns/AlternixDE/main/update/version.txt"

REMOTE_VERSION=$(curl -fs "$VERSION_URL")

# Return a choice in ALT_MENU_CHOICE (1=reboot, 2=desktop). In Alacritty,
# clicking/tapping the printed [word] triggers the same choice as the digit.
# SGR mouse reports contain the terminal-cell coordinates of the click; we
# query the cursor position only to locate the two printed option rows.
alt_finish_update_choice() {
    local key seq ch response row col button action i
    local menu_end_row=0 reboot_row=0 desktop_row=0
    local mouse_ready=0 pressed_target=0 target=0
    local screen_columns=0
    ALT_MENU_CHOICE=

    printf '\nClick or tap an option below (or press 1 / 2):\n'
    printf '    \033[1;4;36m[Reboot]\033[0m\n'
    printf '    \033[1;4;36m[Continue to Desktop]\033[0m\n'

    if [[ -t 0 && -t 1 && "${TERM:-dumb}" != dumb ]] &&
       exec {ALT_MENU_FD}<>/dev/tty; then
        ALT_MENU_STTY=$(stty -g <&"$ALT_MENU_FD") || ALT_MENU_STTY=
        if [[ -n "$ALT_MENU_STTY" ]] &&
           stty -echo -icanon min 1 time 0 <&"$ALT_MENU_FD"; then
            screen_columns=$(tput cols 2>/dev/null || printf '0')
            # The option rows must not wrap (the longer is 25 columns).
            if [[ "$screen_columns" =~ ^[0-9]+$ ]] && (( screen_columns >= 25 )); then
                printf '\033[6n' >&"$ALT_MENU_FD" # cursor position report
                response=
                for (( i=0; i<32; i++ )); do
                    if ! IFS= read -r -s -N1 -t 0.2 -u "$ALT_MENU_FD" ch; then
                        break
                    fi
                    response+="$ch"
                    [[ "$ch" == R ]] && break
                done
                if [[ "$response" =~ ^$'\033'\[([0-9]+)\;([0-9]+)R$ ]]; then
                    menu_end_row=$((10#${BASH_REMATCH[1]}))
                    reboot_row=$(( menu_end_row - 2 ))
                    desktop_row=$(( menu_end_row - 1 ))
                    if (( reboot_row > 0 )); then
                        printf '\033[?1006h\033[?1000h' >&"$ALT_MENU_FD"
                        ALT_MENU_MOUSE_ACTIVE=1
                        mouse_ready=1
                    fi
                fi
            fi
        else
            alt_menu_cleanup
        fi
    fi

    while true; do
        if [[ -n "$ALT_MENU_FD" ]]; then
            IFS= read -r -s -N1 -u "$ALT_MENU_FD" key || return 1
        else
            IFS= read -r -s -n1 key || return 1
        fi

        case "$key" in
            1|2)
                ALT_MENU_CHOICE=$key
                alt_menu_cleanup
                return 0
                ;;
            $'\033')
                # Consume a complete SGR mouse event; ignore arrows, scrolling,
                # unsupported button events, and other escape sequences.
                seq=
                if [[ -n "$ALT_MENU_FD" ]]; then
                    for (( i=0; i<32; i++ )); do
                        if ! IFS= read -r -s -N1 -t 0.12 -u "$ALT_MENU_FD" ch; then
                            break
                        fi
                        seq+="$ch"
                        [[ "$ch" == M || "$ch" == m ]] && break
                    done
                fi
                if (( mouse_ready )) &&
                   [[ "$seq" =~ ^\[\<([0-9]+)\;([0-9]+)\;([0-9]+)([Mm])$ ]]; then
                    button=${BASH_REMATCH[1]}
                    col=${BASH_REMATCH[2]}
                    row=${BASH_REMATCH[3]}
                    action=${BASH_REMATCH[4]}
                    target=0
                    # Count the bracketed text itself as the clickable region.
                    if (( row == reboot_row && col >= 5 && col <= 12 )); then
                        target=1
                    elif (( row == desktop_row && col >= 5 && col <= 25 )); then
                        target=2
                    fi
                    if [[ "$button" == 0 && "$action" == M ]]; then
                        pressed_target=$target
                    elif [[ "$button" == 0 && "$action" == m ]]; then
                        if (( target != 0 && target == pressed_target )); then
                            ALT_MENU_CHOICE=$target
                            alt_menu_cleanup
                            return 0
                        fi
                        pressed_target=0
                    fi
                fi
                ;;
        esac
    done
}

while true; do

    LOCAL_VERSION=$(cat /usr/share/alternix/version.txt 2>/dev/null)
    REMOTE_VERSION=$(curl -fs "$VERSION_URL")

    if [ -z "$REMOTE_VERSION" ]; then
        echo ""
        echo "[------ERROR------]"
        echo "Unable to check for updates."
        echo "Check Internet Connection."
        echo ""
        echo "1) Retry"
        echo "2) Exit"
        read -p "Select option: " choice

        if [ "$choice" = "1" ]; then
            clear
            continue
        else
            exit 1
        fi
    fi

    if dpkg --compare-versions "$REMOTE_VERSION" gt "$LOCAL_VERSION"; then
        echo ""
        echo "New Update found!"
        echo ""
        echo "--------------------------------"
        echo "Current Version: $LOCAL_VERSION"
        echo "New Version: $REMOTE_VERSION"
        echo "--------------------------------"
        echo ""
        echo "Downloading Update..."
        echo ""

        TMP_DIR=$(mktemp -d) || exit 1

        if ! git clone "$REPO_URL" "$TMP_DIR"; then
            echo ""
            echo "[------ERROR------]"
            echo "Download failed.."
            echo ""
            cd /
            rm -rf "$TMP_DIR"

            echo "1) Retry"
            echo "2) Exit"
            read -p "Select option: " choice1

            if [ "$choice1" = "1" ]; then
                clear
                continue
            else
                exit 1
            fi
        fi

        cd "$TMP_DIR" || exit 1

        echo ""
        echo "Download Complete!"
        chmod +x install-update.sh
        echo ""
        echo "Installing Update..."
        echo ""

        if ! ./install-update.sh; then
            echo ""
            echo "[------ERROR------]"
            echo "Installation failed.."
            echo ""
            cd /
            rm -rf "$TMP_DIR"

            echo "1) Retry"
            echo "2) Exit"
            read -p "Select option: " choice2

            if [ "$choice2" = "1" ]; then
                clear
                continue
            else
                exit 1
            fi
        fi

        echo "=============================================="
        echo "     Installed Version: $REMOTE_VERSION"
        echo "=============================================="
        echo ""
        sleep 2
        cd /
        echo ""
        echo "Cleaning Installation Crumbs..."
        echo ""
        sleep 1
        echo "Resetting System Setter..."
        echo ""
        sleep 1
        echo "Parsing un-passable Conduits..."
        echo ""
        echo "Removing temp directory..."
        rm -rf "$TMP_DIR"
        echo ""
        echo ""
        if ! alt_finish_update_choice; then
            echo "ERROR: Unable to read an update completion choice." >&2
            exit 1
        fi
        if [[ "$ALT_MENU_CHOICE" == 1 ]]; then
            echo "Beginning Reboot Sequence..."
            echo " "
            echo "This window will self-destruct in 5 seconds..."
            sleep 1
            echo "5.."
            sleep 1
            echo "4.."
            sleep 1
            echo "3.."
            sleep 1
            echo "2.."
            sleep 1
            echo "1.."
            sleep 1
            sudo reboot
        else
            echo ""
            echo "Returning to desktop..."
        fi
        # Leave the outer update-check loop too; do not start another check
        # or display the no-update countdown after a successful installation.
        break

    else
        echo " "
        echo "No Update needed."
        echo " "
        #echo "Current Version: $LOCAL_VERSION"
        echo " "
        echo "This window will self-destruct in 5 seconds..."
        sleep 1
        echo "5.."
        sleep 1
        echo "4.."
        sleep 1
        echo "3.."
        sleep 1
        echo "2.."
        sleep 1
        echo "1.."
        sleep 1
        break
    fi
done
